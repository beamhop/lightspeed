[Unit]
Description=Beamhop relay (Nostr, TURN, data relay, Blossom, admin)
Documentation=https://github.com/beamhop/lightspeed/tree/main/packages/relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=beamhop
Group=beamhop
ExecStart=/usr/local/bin/beamhop-relay --config /etc/beamhop/beamhop-relay.toml
Restart=on-failure
RestartSec=2
LimitNOFILE=1048576
Environment=BEAMHOP_DATA_DIR=/var/lib/beamhop-relay
StateDirectory=beamhop-relay
ReadWritePaths=/var/lib/beamhop-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
