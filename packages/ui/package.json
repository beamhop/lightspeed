{
  "name": "@beamhop/ui",
  "version": "0.0.0",
  "description": "Beamhop design tokens and shared Preact components",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun build ./src/index.ts --outdir dist --target browser --external preact && tsc --emitDeclarationOnly --outDir dist"
  },
  "peerDependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^18.0.0",
    "happy-dom": "^18.0.0",
    "preact": "^10.24.0",
    "preact-render-to-string": "^6.5.0"
  }
}
