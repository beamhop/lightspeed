{
  "name": "@beamhop/turn",
  "version": "0.0.0",
  "description": "STUN/TURN server in TypeScript for Bun",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./stun": "./src/stun.ts",
    "./client": "./src/client.ts"
  },
  "bin": { "beamhop-turn": "./src/bin.ts" },
  "scripts": {
    "test": "bun test",
    "bench": "bun bench/udp.ts",
    "start": "bun src/bin.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun && tsc --emitDeclarationOnly --outDir dist"
  },
  "devDependencies": {
    "@beamhop/p2p": "workspace:*",
    "fast-check": "^3.23.0"
  }
}
