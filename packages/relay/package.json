{
  "name": "@beamhop/relay",
  "version": "0.0.0",
  "description": "Beamhop relay: Nostr relay, TURN, data relay, admin UI, Blossom and payments in one Bun process",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./templates": "./src/templates.ts"
  },
  "bin": {
    "beamhop-relay": "./src/bin.ts"
  },
  "scripts": {
    "start": "bun ./src/bin.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun run compile:linux-x64 && bun run compile:linux-arm64 && bun run compile:darwin-arm64",
    "compile:linux-x64": "bun build ./src/bin.ts --compile --minify --sourcemap --target=bun-linux-x64 --outfile dist/beamhop-relay-linux-x64",
    "compile:linux-arm64": "bun build ./src/bin.ts --compile --minify --sourcemap --target=bun-linux-arm64 --outfile dist/beamhop-relay-linux-arm64",
    "compile:darwin-arm64": "bun build ./src/bin.ts --compile --minify --sourcemap --target=bun-darwin-arm64 --outfile dist/beamhop-relay-darwin-arm64",
    "compile": "bun build ./src/bin.ts --compile --minify --sourcemap --outfile dist/beamhop-relay"
  },
  "dependencies": {
    "@beamhop/nostr-relay": "workspace:*",
    "@beamhop/p2p": "workspace:*",
    "@beamhop/relay-admin": "workspace:*",
    "@beamhop/turn": "workspace:*",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "qrcode-generator": "^1.4.4"
  }
}
