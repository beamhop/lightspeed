---
// Phone/tablet "On this page": a sticky bar under the header that drops the list down over the page.
import { ChevronRight } from 'lucide-react'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'
import TocList from './TocList.astro'

const { toc } = Astro.locals.starlightRoute
---

{
  toc && (
    <details data-bh-toc-mobile class="group relative">
      <summary class="flex h-12 cursor-pointer list-none items-center gap-3 text-sm [&::-webkit-details-marker]:hidden">
        <span class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'pointer-events-none')}>
          {Astro.locals.t('tableOfContents.onThisPage')}
          <ChevronRight className="transition-transform group-open:rotate-90" />
        </span>
        <span data-bh-toc-current class="min-w-0 truncate text-muted-foreground" />
      </summary>
      <nav
        data-bh-toc
        aria-label={Astro.locals.t('tableOfContents.onThisPage')}
        class="absolute inset-x-0 top-full z-30 -mx-4 max-h-[60dvh] overflow-y-auto border-b bg-popover px-4 py-3 text-popover-foreground shadow-md md:mx-0 md:rounded-b-lg md:border-x"
      >
        <TocList items={toc.items} />
      </nav>
    </details>
  )
}

<script>
  import '@/lib/toc'
</script>
