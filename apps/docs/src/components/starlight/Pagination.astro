---
// Previous / next as shadcn cards.
import { ArrowLeft, ArrowRight } from 'lucide-react'
import { cn } from '@/lib/utils'

const { prev, next } = Astro.locals.starlightRoute.pagination
const card =
  'group flex min-w-0 flex-col gap-1 rounded-lg border bg-card p-4 text-card-foreground shadow-xs transition-colors hover:bg-accent/50'
---

{
  (prev || next) && (
    <nav class="grid gap-4 sm:grid-cols-2" aria-label="Pagination">
      {prev && (
        <a href={prev.href} rel="prev" class={card}>
          <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
            <ArrowLeft className="size-3.5 transition-transform group-hover:-translate-x-0.5" />
            {Astro.locals.t('page.previousLink')}
          </span>
          <span class="truncate text-sm font-medium">{prev.label}</span>
        </a>
      )}
      {next && (
        <a href={next.href} rel="next" class={cn(card, 'items-end text-right sm:col-start-2')}>
          <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
            {Astro.locals.t('page.nextLink')}
            <ArrowRight className="size-3.5 transition-transform group-hover:translate-x-0.5" />
          </span>
          <span class="max-w-full truncate text-sm font-medium">{next.label}</span>
        </a>
      )}
    </nav>
  )
}
