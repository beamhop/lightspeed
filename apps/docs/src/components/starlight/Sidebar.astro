---
// Docs sidebar in the shadcn/ui sidebar style. Starlight's persister keeps the scroll position and
// the open groups between pages.
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro'
import { buttonVariants } from '@/components/ui/button'
import { NAV_LINKS, navActive } from '@/lib/site'
import { cn } from '@/lib/utils'
import SidebarSublist from './SidebarSublist.astro'

const { sidebar } = Astro.locals.starlightRoute
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const current = Astro.url.pathname
---

<div class="mb-6 flex flex-col gap-0.5 border-b pb-6 md:hidden">
  {
    NAV_LINKS.map((l) => (
      <a
        href={`${base}${l.href}`}
        aria-current={navActive(l, current, base) ? 'page' : undefined}
        class={cn(
          buttonVariants({ variant: 'ghost', size: 'sm' }),
          'justify-start px-2 text-foreground/80 aria-[current=page]:bg-accent aria-[current=page]:text-accent-foreground',
        )}
      >
        {l.label}
      </a>
    ))
  }
</div>
<SidebarPersister>
  <SidebarSublist sublist={sidebar} />
</SidebarPersister>
