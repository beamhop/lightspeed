---
// shadcn-style light/dark toggle. Shares Starlight's `starlight-theme` storage key, so the choice
// carries between the landing page and the docs.
import { Moon, Sun } from 'lucide-react'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'

interface Props {
  class?: string
}
---

<button
  type="button"
  class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'bh-theme-toggle', Astro.props.class)}
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <Sun className="hidden dark:block" />
  <Moon className="dark:hidden" />
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.bh-theme-toggle')) {
    button.addEventListener('click', () => {
      const root = document.documentElement
      const next = root.dataset.theme === 'light' ? 'dark' : 'light'
      root.dataset.theme = next
      try {
        localStorage.setItem('starlight-theme', next)
      } catch {
        // Storage disabled: the theme still switches for this page view.
      }
    })
  }
</script>
